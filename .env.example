# Import-only migration sample — OrbitRelay never reads this during an agent run.
# Run: orbitrelay provider import-env --provider deepseek
# Keep exactly one provider API key uncommented while importing.

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-v4-flash

# OPENAI_API_KEY=replace-with-your-openai-api-key
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# XAI_API_KEY=replace-with-your-xai-api-key
